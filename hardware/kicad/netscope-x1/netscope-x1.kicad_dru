(version 1)
# Generated by tools/gen_kicad.py.  Spacing between electrical domains, from
# rules.isolation in hardware/pcb/floorplan.yaml.  A design value, not a safety
# rating: creepage and clearance for the PoE barrier still need a standards review.
(rule "isolation_LINE_SYS"
  (condition "A.hasNetclass('LINE') && B.hasNetclass('SYS')")
  (constraint clearance (min 2.5mm)))
(rule "isolation_POE_SYS"
  (condition "A.hasNetclass('POE') && B.hasNetclass('SYS')")
  (constraint clearance (min 2.5mm)))
(rule "isolation_LINE_POE"
  (condition "A.hasNetclass('LINE') && B.hasNetclass('POE')")
  (constraint clearance (min 2.5mm)))
